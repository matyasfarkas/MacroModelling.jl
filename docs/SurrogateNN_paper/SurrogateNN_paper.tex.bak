\label{tab:param_nonlinearity}
\begin{tabular}{llcc}
\toprule
Parameter & Description & Correlation & $R^2$ (univariate) \\
\midrule
\multicolumn{4}{l}{\textit{Persistence parameters}} \\
$\rho_g$ & Govt.\ spending & $+0.176$ & 0.031 \\
$\rho_\pi$ & Price markup & $-0.065$ & 0.004 \\
$\rho_{qs}$ & Investment & $-0.061$ & 0.004 \\
