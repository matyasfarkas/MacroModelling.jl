\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces ZLB contribution to nonlinearity in the Gal\'i model. Blue circles: FOM--ROM1 gap without the ZLB constraint. Red diamonds: with the ZLB. Below $3\sigma $ shocks the two are nearly indistinguishable; the ZLB begins to matter at $5\sigma $ and roughly quadruples the gap at $10\sigma $. At empirically relevant shock scales the ZLB contributes negligibly to the FOM--ROM1 gap.}}{28}{figure.caption.9}\protected@file@percent }
\newlabel{fig:gali_obc_vs_no_obc}{{6}{28}{ZLB contribution to nonlinearity in the Gal\'i model. Blue circles: FOM--ROM1 gap without the ZLB constraint. Red diamonds: with the ZLB. Below $3\sigma $ shocks the two are nearly indistinguishable; the ZLB begins to matter at $5\sigma $ and roughly quadruples the gap at $10\sigma $. At empirically relevant shock scales the ZLB contributes negligibly to the FOM--ROM1 gap}{figure.caption.9}{}}
